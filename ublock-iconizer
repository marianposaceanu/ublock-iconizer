#!/usr/bin/env ruby
# frozen_string_literal: true

# ublock-iconizer: make the uBlock Origin Lite toolbar icon in Safari a grey
# template icon (like Apple's own), and restore the pristine App Store build.
#
#   ublock-iconizer status  [--app PATH]
#   ublock-iconizer patch   [--app PATH] [--identity NAME] [--style grey|template]
#   ublock-iconizer restore [--app PATH] [--delete-backup]
#
# Patching keeps a pristine copy of the app under ~/Library/Application Support
# so `restore` can put it back without a reinstall from the App Store.

require 'fileutils'
require 'json'
require 'open3'
require 'optparse'
require 'time'
require 'tmpdir'

module UblockIconizer
  DEFAULT_APP_PATH = '/Applications/uBlock Origin Lite.app'
  DEFAULT_SUPPORT_DIR = '~/Library/Application Support/ublock-iconizer'
  SUPPORT_DIR = File.expand_path(ENV.fetch('UBLOCK_ICONIZER_HOME', DEFAULT_SUPPORT_DIR))

  class Error < StandardError; end

  # Runs external commands and turns a failing exit into an Error.
  module Shell
    module_function

    def run(*command, stdin: nil)
      Open3.capture3(*command, stdin_data: stdin)
    end

    def run!(*command, stdin: nil)
      stdout, stderr, status = run(*command, stdin: stdin)
      return stdout if status.success?

      detail = stderr.strip.empty? ? stdout.strip : stderr.strip
      raise Error, "#{command.first} failed: #{detail}"
    end

    def succeeds?(*command)
      _, _, status = run(*command)
      status.success?
    end

    def which(name)
      stdout, _, status = run('which', name)
      status.success? ? stdout.strip : nil
    end
  end

  # Colours for one icon state. With a `detail` colour the white bar and border
  # are recoloured too; without one the icon becomes a black template.
  Paint = Struct.new(:body, :detail, keyword_init: true)

  # `on` paints the active icons, `off` the "no filtering" ones. A nil `off`
  # leaves the "no filtering" icons as shipped.
  Style = Struct.new(:name, :on, :off, keyword_init: true)

  # Safari tints a toolbar icon with the accent colour whenever the extension
  # has access to the tab, if the icon is single-coloured or every pixel is
  # near-grey (measured: a 24-unit channel spread still counts as grey, 45
  # does not). The grey style keeps a neutral body and puts the chroma in the
  # bar and border as a very pale blue, so Safari shows it as-is.
  STYLES = {
    'grey' => Style.new(
      name: 'grey',
      on: Paint.new(body: '#828282', detail: '#C8D8F5'),
      off: Paint.new(body: '#B4B4B4', detail: '#C8D8F5')
    ),
    'template' => Style.new(
      name: 'template',
      on: Paint.new(body: 'black'),
      off: nil
    )
  }.freeze

  # The installed app bundle and the Safari extension inside it.
  class AppBundle
    EXTENSION_RELATIVE_PATH = 'Contents/PlugIns/uBlock Origin Lite Extension.appex'
    APP_STORE_AUTHORITY = 'Apple Mac OS Application Signing'
    ICON_SIZES = [16, 32, 64, 128].freeze
    LSREGISTER = '/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister'

    attr_reader :path

    def initialize(path)
      @path = path
    end

    def name
      File.basename(path)
    end

    def extension_path
      File.join(path, EXTENSION_RELATIVE_PATH)
    end

    def image_dir
      File.join(extension_path, 'Contents/Resources/img')
    end

    def exist?
      File.directory?(path) && File.directory?(extension_path)
    end

    def version
      info_plist = File.join(path, 'Contents/Info.plist')
      Shell.run!('plutil', '-extract', 'CFBundleShortVersionString', 'raw', info_plist).strip
    end

    def on_icons
      ICON_SIZES.map { |size| File.join(image_dir, "icon_#{size}.png") }
    end

    def off_icons
      ICON_SIZES.map { |size| File.join(image_dir, "icon_#{size}_off.png") }
    end

    def signing_authority
      _, stderr, = Shell.run('codesign', '-dv', '--verbose=2', path)
      stderr[/^Authority=(.*)$/, 1]
    end

    def app_store_signed?
      signing_authority == APP_STORE_AUTHORITY
    end

    def signature_valid?
      CodeSigner.verifies?(path)
    end

    # Untouched App Store build: Apple-signed and the seal still verifies.
    def pristine?
      app_store_signed? && signature_valid?
    end

    def verify_signature!
      Shell.run!('codesign', '--verify', '--deep', '--strict', path)
    end

    def entitlements(target = path)
      xml = Shell.run!('codesign', '-d', '--entitlements', '-', '--xml', target)
      return {} if xml.strip.empty?

      json = Shell.run!('plutil', '-convert', 'json', '-o', '-', '-', stdin: xml)
      JSON.parse(json)
    end

    def writable?
      File.writable?(image_dir) && File.writable?(File.dirname(path))
    end

    # Tell LaunchServices and pluginkit about the re-signed bundle so Safari
    # picks up the new one.
    def register
      Shell.run(LSREGISTER, '-f', path)
      Shell.run('pluginkit', '-a', extension_path)
    end
  end

  # Inspects and recolours toolbar PNGs with ImageMagick 7.
  class IconPainter
    MISSING_MAGICK_ERROR = 'ImageMagick not found. Install it with: brew install imagemagick'
    # Mean HSL saturation below this counts as grey. The stock maroon icon
    # scores ~0.6; both patched styles stay well under 0.1.
    GREY_SATURATION_LIMIT = 0.15

    def grey?(png)
      saturation = Shell.run!(
        magick, png,
        '-alpha', 'off',
        '-colorspace', 'HSL',
        '-channel', 'G', '-separate', '+channel',
        '-format', '%[fx:mean]', 'info:'
      )
      saturation.to_f < GREY_SATURATION_LIMIT
    end

    def paint(png, paint)
      if paint.detail
        recolour_body_and_detail(png, paint)
      else
        cut_out_template(png, paint)
      end
    end

    private

      def magick
        @magick ||= Shell.which('magick') || raise(Error, MISSING_MAGICK_ERROR)
      end

      # Recolour the shield body and the white bar/border separately, touching
      # RGB only so the anti-aliased alpha edge survives.
      def recolour_body_and_detail(png, paint)
        Shell.run!(
          magick, png,
          '-channel', 'RGB',
          '-fuzz', '25%', '-fill', paint.detail, '-opaque', 'white',
          '-fill', paint.body, '+opaque', paint.detail,
          '+channel',
          png
        )
      end

      # Black on transparent. The white bar and border are cut out, otherwise
      # the shield becomes a solid blob once Safari tints it.
      def cut_out_template(png, paint)
        Shell.run!(
          magick, png,
          '-fuzz', '30%', '-transparent', 'white',
          '-fill', paint.body, '-colorize', '100%',
          png
        )
      end
  end

  # Re-signs bundles with an identity from the user's keychain, or ad-hoc.
  class CodeSigner
    AD_HOC_IDENTITY = '-'
    # Entitlements that only validate with the original team's provisioning,
    # which a re-signed build cannot carry.
    TEAM_BOUND_ENTITLEMENTS = %w[
      com.apple.application-identifier
      com.apple.developer.team-identifier
      keychain-access-groups
      com.apple.security.application-groups
    ].freeze

    class << self
      def verifies?(bundle)
        Shell.succeeds?('codesign', '--verify', '--deep', '--strict', bundle)
      end

      def default_identity
        identities = Shell.run!('security', 'find-identity', '-v', '-p', 'codesigning')
        identities[/"(Apple Development: [^"]+)"/, 1]
      end
    end

    attr_reader :identity

    def initialize(identity)
      @identity = identity
    end

    def ad_hoc?
      identity == AD_HOC_IDENTITY
    end

    def description
      ad_hoc? ? 'ad-hoc identity' : identity
    end

    def sign!(target, entitlements)
      portable_entitlements = entitlements.reject { |key, _| TEAM_BOUND_ENTITLEMENTS.include?(key) }

      Dir.mktmpdir('ublock-iconizer') do |dir|
        plist = File.join(dir, 'entitlements.plist')
        File.write(plist, entitlements_xml(portable_entitlements))
        Shell.run!(
          'codesign', '--force',
          '--options', 'runtime',
          '--timestamp=none',
          '--entitlements', plist,
          '--sign', identity,
          target
        )
      end
    end

    private

      def entitlements_xml(entitlements)
        Shell.run!('plutil', '-convert', 'xml1', '-o', '-', '-', stdin: JSON.generate(entitlements))
      end
  end

  # Remembers the last patch and restore in state.json.
  class State
    def initialize(dir)
      @file = File.join(dir, 'state.json')
    end

    def read
      return {} unless File.exist?(@file)

      JSON.parse(File.read(@file))
    end

    def write(values)
      FileUtils.mkdir_p(File.dirname(@file))
      File.write(@file, JSON.pretty_generate(values) + "\n")
    end
  end

  # Keeps one pristine copy of the app per version.
  class BackupStore
    def initialize(root)
      @root = root
    end

    def dir_for(version)
      File.join(@root, 'backup', version)
    end

    def path_for(version, app_name)
      File.join(dir_for(version), app_name)
    end

    def save!(app)
      destination = path_for(app.version, app.name)
      if File.directory?(destination)
        # A backup that still verifies may be the only pristine copy left.
        return destination if CodeSigner.verifies?(destination)

        FileUtils.rm_rf(destination)
      end

      FileUtils.mkdir_p(File.dirname(destination))
      # ditto preserves resource forks, xattrs (App Store metadata) and signatures.
      Shell.run!('ditto', app.path, destination)
      destination
    end

    def restore!(version, app)
      source = path_for(version, app.name)
      raise Error, "No backup for version #{version} at #{source}" unless File.directory?(source)

      unless CodeSigner.verifies?(source)
        raise Error, "Backup at #{source} does not verify; reinstall from the App Store instead"
      end

      guard_removal!(app.path)
      # Copy next to the live app first, then swap, so a failed copy leaves the app in place.
      staging = "#{app.path}.ublock-iconizer-restore"
      FileUtils.rm_rf(staging)
      Shell.run!('ditto', source, staging)
      FileUtils.rm_rf(app.path)
      File.rename(staging, app.path)
    end

    private

      def guard_removal!(path)
        looks_like_app = path.end_with?('.app') && File.directory?(File.join(path, 'Contents/PlugIns'))
        raise Error, "Refusing to remove #{path}: not an app bundle with plug-ins" unless looks_like_app
      end
  end

  module Commands
    # Shared collaborators and checks for the three commands.
    class Base
      def initialize(app:, backups:, state:, options:)
        @app = app
        @backups = backups
        @state = state
        @options = options
      end

      private

        attr_reader :app, :backups, :state, :options

        def ensure_app_exists!
          return if app.exist?

          raise Error, "App not found at #{app.path}. Install uBlock Origin Lite from the App Store first."
        end

        # App Store installs are owned by root. Signing must run as the user
        # (the identity lives in the user's keychain), so take ownership once.
        def take_ownership!
          return if app.writable?

          user = Shell.run!('id', '-un').strip
          puts "#{app.path} is not writable by #{user}; taking ownership (sudo will ask for your password)..."
          return if system('sudo', 'chown', '-R', "#{user}:staff", app.path)

          raise Error, "could not take ownership. Run manually: sudo chown -R #{user}:staff #{app.path.inspect}"
        end
    end

    class Status < Base
      def run
        ensure_app_exists!
        version = app.version
        last = state.read

        puts "App:        #{app.path}"
        puts "Version:    #{version}"
        puts "Signed by:  #{signer_line}"
        puts "Icons:      #{icons_line(last)}"
        puts "Backup:     #{backup_line(version)}"
        puts "Last patch: #{last['patched_at'] || 'never'} (version #{last['version'] || '-'})" if last.any?

        return unless updated_since_last_patch?(version, last)

        puts
        puts 'The App Store has updated the app since the last patch. Run `ublock-iconizer patch` again.'
      end

      private

        def signer_line
          authority = app.signing_authority || 'unsigned'
          app.signature_valid? ? authority : "#{authority} (signature INVALID)"
        end

        def icons_line(last)
          painter = IconPainter.new
          return 'coloured (stock)' unless app.on_icons.all? { |png| painter.grey?(png) }

          last['style'] ? "grey (patched, style #{last['style']})" : 'grey (patched)'
        end

        def backup_line(version)
          backup = backups.path_for(version, app.name)
          File.directory?(backup) ? backup : 'none for this version'
        end

        def updated_since_last_patch?(version, last)
          return false unless app.pristine?
          return false if last['version'].nil?

          last['version'] != version
        end
    end

    class Patch < Base
      def run
        ensure_app_exists!
        take_ownership!
        version = app.version
        signer = CodeSigner.new(resolve_identity)

        case readiness
        when :pristine
          puts "Backing up pristine #{version} build..."
          puts "  -> #{backups.save!(app)}"
        when :already_patched
          puts "Already patched (version #{version}). Nothing to do."
          return
        when :invalid_signature
          raise Error, 'App is modified but not validly signed (a previous patch probably failed mid-way). ' \
                       'Run `ublock-iconizer restore`, or reinstall from the App Store, then patch again.'
        when :foreign_signer
          raise Error, 'App is signed by someone else and not patched by this tool. Reinstall it from the App Store first.'
        end

        recolour_icons(style)
        re_sign(signer)
        app.register
        remember_patch(version, signer)
        print_next_steps
      end

      private

        def style
          STYLES.fetch(options[:style])
        end

        def resolve_identity
          identity = options[:identity] || CodeSigner.default_identity
          return identity if identity

          warn 'warning: no "Apple Development" identity found; signing ad-hoc. Safari will only load the'
          warn '         extension with Develop > Allow Unsigned Extensions, which resets on every launch.'
          CodeSigner::AD_HOC_IDENTITY
        end

        def readiness
          return :pristine if app.pristine?
          return :invalid_signature unless app.signature_valid?
          return :already_patched if icons_grey?

          :foreign_signer
        end

        def icons_grey?
          painter = IconPainter.new
          app.on_icons.all? { |png| painter.grey?(png) }
        end

        def recolour_icons(style)
          puts "Recolouring toolbar icons (style: #{style.name})..."
          painter = IconPainter.new
          paint_all(painter, app.on_icons, style.on)
          paint_all(painter, app.off_icons, style.off)
        end

        def paint_all(painter, pngs, paint)
          return if paint.nil?

          pngs.each do |png|
            raise Error, "Missing icon #{png}" unless File.file?(png)

            painter.paint(png, paint)
          end
        end

        def re_sign(signer)
          puts "Re-signing with #{signer.description}..."
          signer.sign!(app.extension_path, app.entitlements(app.extension_path))
          signer.sign!(app.path, app.entitlements(app.path))
          app.verify_signature!
          puts 'Signature verified.'
        end

        def remember_patch(version, signer)
          state.write(
            'version' => version,
            'patched_at' => Time.now.iso8601,
            'identity' => signer.identity,
            'style' => style.name,
            'app' => app.path
          )
        end

        def print_next_steps
          puts
          puts 'Done. Quit and reopen Safari, then enable the extension in Safari > Settings > Extensions.'
          puts 'Per-site permissions will need to be granted again (the signing team changed).'
        end
    end

    class Restore < Base
      def run
        ensure_app_exists!
        version = app.version
        if app.pristine?
          puts "App is the pristine App Store build (#{version}). Nothing to restore."
          return
        end

        take_ownership!
        puts "Restoring pristine #{version} build from backup..."
        backups.restore!(version, app)
        app.verify_signature!
        app.register
        delete_backup(version) if options[:delete_backup]
        state.write(state.read.merge('restored_at' => Time.now.iso8601))
        puts 'Done. Quit and reopen Safari. The App Store can update the app again.'
      end

      private

        def delete_backup(version)
          FileUtils.rm_rf(backups.dir_for(version))
          puts 'Backup deleted.'
        end
    end
  end

  class CLI
    COMMANDS = {
      'status' => Commands::Status,
      'patch' => Commands::Patch,
      'restore' => Commands::Restore
    }.freeze
    USAGE = 'usage: ublock-iconizer (status|patch|restore) [--app PATH] [--identity NAME] ' \
            '[--style grey|template] [--delete-backup]'

    def initialize(argv)
      @argv = argv.dup
      @options = { app: DEFAULT_APP_PATH, identity: nil, delete_backup: false, style: 'grey' }
    end

    def run
      command_class = COMMANDS.fetch(parse_command_name) { usage(1) }
      command = command_class.new(
        app: AppBundle.new(@options[:app]),
        backups: BackupStore.new(SUPPORT_DIR),
        state: State.new(SUPPORT_DIR),
        options: @options
      )
      command.run
      0
    rescue Error => e
      warn "error: #{e.message}"
      1
    end

    private

      def parse_command_name
        parser = OptionParser.new do |o|
          o.banner = 'usage: ublock-iconizer (status|patch|restore) [options]'
          o.on('--app PATH', "App bundle to operate on (default: #{DEFAULT_APP_PATH})") do |value|
            @options[:app] = File.expand_path(value)
          end
          o.on('--identity NAME', 'codesign identity (default: first "Apple Development" identity, else ad-hoc)') do |value|
            @options[:identity] = value
          end
          o.on('--delete-backup', 'restore: remove the pristine backup afterwards') do
            @options[:delete_backup] = true
          end
          o.on('--style STYLE', STYLES.keys, "patch: #{STYLES.keys.join('|')} (default: grey). " \
                                             'template is tinted blue by Safari on tabs the extension can access') do |value|
            @options[:style] = value
          end
          o.on('-h', '--help') do
            puts o
            exit 0
          end
        end
        parser.parse!(@argv)
        @argv.shift || usage(1)
      end

      def usage(code)
        warn USAGE
        exit code
      end
  end
end

exit UblockIconizer::CLI.new(ARGV).run if $PROGRAM_NAME == __FILE__
