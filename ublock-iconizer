#!/usr/bin/env ruby
# frozen_string_literal: true

# ublock-iconizer: make the uBlock Origin Lite toolbar icon in Safari a grey
# template icon (like Apple's own), and restore the pristine App Store build.
#
#   ublock-iconizer status  [--app PATH]
#   ublock-iconizer patch   [--app PATH] [--identity NAME] [--style grey|template]
#   ublock-iconizer restore [--app PATH] [--delete-backup]

require_relative 'lib/ublock_iconizer'

exit UblockIconizer::CLI.new(ARGV).run
